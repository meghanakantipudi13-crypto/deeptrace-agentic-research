# Model provider (planned default: Vertex AI / Gemini)
DEEPTRACE_MODEL_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
DEEPTRACE_MODEL=gemini-2.5-flash

# Search provider. Missing credentials may use labeled fixtures only outside production.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=replace-with-secret-manager-reference-at-deploy-time

# Durable storage
DEEPTRACE_MEMORY_BACKEND=gcs
DEEPTRACE_GCS_BUCKET=your-deeptrace-bucket
DEEPTRACE_CHECKPOINT_BACKEND=postgres
DEEPTRACE_SQLITE_PATH=.deeptrace-checkpoints.sqlite
# Supply this value through Secret Manager; never commit a real connection string.
DEEPTRACE_POSTGRES_URI=postgresql://user:password@host:5432/deeptrace?sslmode=require
# Run schema setup during a controlled first deployment, then set this false.
DEEPTRACE_POSTGRES_SETUP=false
LANGGRAPH_STRICT_MSGPACK=true

# Application controls
DEEPTRACE_ENV=development
DEEPTRACE_REQUEST_TIMEOUT_SECONDS=20
DEEPTRACE_RATE_LIMIT_PER_MINUTE=30
DEEPTRACE_LOG_LEVEL=INFO

# Optional tracing. Keep disabled until a backend and data policy are approved.
DEEPTRACE_TRACING_ENABLED=false
