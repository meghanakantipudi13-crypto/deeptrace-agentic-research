# Model provider (planned default: Vertex AI / Gemini)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
DEEPTRACE_MODEL=configure-after-provider-validation

# Search provider (planned adapter; no real key belongs in this file)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=replace-with-secret-manager-reference-at-deploy-time

# Durable storage
DEEPTRACE_GCS_BUCKET=your-deeptrace-bucket
# The PostgreSQL checkpoint URL will be added during the persistence phase
# and supplied through Secret Manager rather than committed configuration.

# Application controls
DEEPTRACE_ENV=development
DEEPTRACE_MAX_RETRIEVAL_ITERATIONS=3
DEEPTRACE_MAX_SOURCES_PER_QUERY=5
DEEPTRACE_REQUEST_TIMEOUT_SECONDS=180
DEEPTRACE_LOG_LEVEL=INFO

# Optional tracing. Keep disabled until a backend and data policy are approved.
DEEPTRACE_TRACING_ENABLED=false
